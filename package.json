{
  "name": "my-react-app",
  "version": "0.1.0",
  "private": true,
  "homepage": ".",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.3",
    "react-scripts": "5.0.1",
    "recharts": "^3.10.1",
    "web-vitals": "^5.3.0"
  },
  "scripts": {
    "start": "node server/server.js",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:server": "node --test server/utils/*.test.js server/middleware/*.test.js",
    "test:all": "npm run test:server && CI=true npm test -- --watchAll=false",
    "lint": "eslint src/ server/ --ext .js,.jsx",
    "eject": "react-scripts eject",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/server.js",
    "client": "PORT=${CLIENT_PORT:-3000} react-scripts start",
    "migrate:chat-storage": "node server/scripts/migrate-chat-storage.js",
    "export:profiles": "node server/scripts/export-profiles-archive.js",
    "restore:profiles": "node server/scripts/restore-profiles-archive.js",
    "migrate:profile-avatars": "node server/scripts/migrate-profile-avatars.js",
    "heroku-postbuild": "npm run build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14"
  },
  "proxy": "http://localhost:5000",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "cacheDirectories": [
    "node_modules"
  ]
}
