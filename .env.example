# Local MySQL/MariaDB connection. Copy this file to .env and set MYSQL_PASSWORD.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=its
MYSQL_USER=admin
MYSQL_PASSWORD=

# Long random value used to sign employee chat access tokens.
# Required in production. Changing it signs everyone out.
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret

# Optional pool and TLS settings.
MYSQL_CONNECTION_LIMIT=10
# MYSQL_SSL=true
