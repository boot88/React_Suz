# Local MySQL/MariaDB connection. Copy this file to .env and set MYSQL_PASSWORD.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=its
MYSQL_USER=admin
MYSQL_PASSWORD=

# Unique random value (at least 32 characters) used to sign access tokens.
# Required for production and recommended for every shared server. Changing it signs everyone out.
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret

# Initial shared passwords are used only when the users table is empty.
# Change individual passwords after the first login.
DEFAULT_EMPLOYEE_PASSWORD=
DEFAULT_ADMIN_PASSWORD=

# Optional manager account stored in MySQL. Never put these values in client code.
MANAGER_LOGIN=
MANAGER_PASSWORD=
MANAGER_NAME=Ответственный менеджер

# Optional pool and TLS settings.
MYSQL_CONNECTION_LIMIT=10
# MYSQL_SSL=true

# Security hardening (helmet). Set DISABLE_CSP=1 only if the strict
# Content-Security-Policy breaks something in your deployment.
# DISABLE_CSP=1

# Optional antivirus command for newly uploaded files. When set, a failed scan
# moves the upload to server/uploads/quarantine instead of publishing it.
# CLAMAV_SCAN_COMMAND=clamscan
